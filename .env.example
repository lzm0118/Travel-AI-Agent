# 智能旅游助手 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== LLM API 密钥 ====================

# 通义千问 (Qwen) API - 阿里云平台
# 获取地址：https://dashscope.aliyun.com/
QWEN_API_KEY=your_openai_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 智谱 AI (GLM) API
# 获取地址：https://open.bigmodel.cn/
ZHIPU_API_KEY=your_openai_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# OpenAI API（可选，作为备用）
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==================== 工具 API 密钥 ====================

# 高德地图 API Key
# 获取地址：https://lbs.amap.com/api/
AMAP_KEY=your_amap_key_here

# 【推荐】联网搜索 - 默认使用 DuckDuckGo（免费，无需API Key）
# 国内部分网络可访问，如无法访问可选择下方备选方案

# 备选1：必应搜索 API（需要申请，每月1000次免费）
# 获取地址：https://azure.microsoft.com/zh-cn/services/cognitive-services/bing-web-search-api/
BING_SEARCH_KEY=your_bing_search_key_here

# 备选2：Serper (Google Search API，需要翻墙)
# 获取地址：https://serper.dev/
# SERPER_API_KEY=your_serper_api_key_here

# ==================== 数据库配置 ====================

# Redis 配置（可选，用于缓存和消息队列）
REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=your_redis_password

# SQLite 配置（默认使用）
DATABASE_URL=sqlite+aiosqlite:///./data/travel_agent.db

# PostgreSQL（可选，生产环境推荐）
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/travel_agent

# ==================== 向量数据库配置 ====================

# ChromaDB 配置
CHROMA_PERSIST_DIR=./data/chroma

# ==================== 服务配置 ====================

# 后端服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# CORS 配置
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT 密钥（用于用户认证，请使用强随机字符串）
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7天

# ==================== MCP/A2A 配置 ====================

# MCP Server 配置
MCP_SERVER_NAME=travel-agent-mcp
MCP_SERVER_VERSION=1.0.0
MCP_TRANSPORT=stdio  # 或 sse

# A2A Server 配置
A2A_SERVER_NAME=travel-agent-a2a
A2A_SERVER_PORT=10000

# ==================== 其他配置 ====================

# 是否启用工具调用
ENABLE_TOOLS=true

# 是否启用记忆系统
ENABLE_MEMORY=true

# 对话历史保留条数
MAX_HISTORY=20

# 请求超时时间（秒）
REQUEST_TIMEOUT=60

# 重试次数
MAX_RETRIES=3
